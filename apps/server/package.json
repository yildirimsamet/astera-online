{
  "name": "@astera/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --keep-names --sourcemap --packages=external --alias:@astera/rules/arena/ui=../../packages/rules/src/arena/ui.ts --alias:@astera/rules/arena=../../packages/rules/src/arena/index.ts --alias:@astera/rules=../../packages/rules/src/index.ts --outfile=dist/server/index.mjs --log-level=warning",
    "dev:arena": "ROLE=arena PORT=3101 ARENA_ENABLED=true ARENA_DEV=true tsx watch src/index.ts",
    "worker": "ROLE=worker tsx src/index.ts",
    "migrate": "tsx src/cli/migrate.ts",
    "season": "tsx src/cli/season.ts",
    "erasure:restore": "tsx src/cli/erasureRestore.ts",
    "bots": "tsx src/cli/bots.ts",
    "radiation": "tsx src/cli/radiation.ts",
    "maintenance": "tsx src/cli/maintenance.ts",
    "starter": "tsx src/cli/starter.ts",
    "capacity:seed": "tsx src/cli/capacity.ts",
    "typecheck": "node ../../tools/heavy.mjs --heap 3072 tsc --noEmit",
    "test": "node ../../tools/heavy.mjs --heap 1024 vitest run --minWorkers=1 --maxWorkers=4",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@astera/rules": "workspace:*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "11.3.1",
    "@fastify/rate-limit": "^11.2.0",
    "@polar-sh/sdk": "1.0.0-alpha.22",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.2.0",
    "file-type": "^21",
    "ioredis": "^6.0.0",
    "jose": "^5.9.6",
    "pino": "^9.5.0",
    "postgres": "^3.4.5",
    "sanitize-html": "^2.17.7",
    "tsx": "^4.23.12",
    "ws": "^8.18.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/sanitize-html": "^2.16.1",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.30.1",
    "esbuild": "0.28.2"
  }
}
