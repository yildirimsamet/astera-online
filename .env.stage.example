# Copy to .env in ~/astera-stage; chmod 600. Generate fresh stage-only secrets.
POSTGRES_USER=astera
POSTGRES_DB=astera
POSTGRES_PASSWORD=
JWT_SECRET=

POSTGRES_PORT=5546
API_PORT_1=3300
API_PORT_2=3301
API_PORT_3=3302
WORKER_PORT=3310

# Pin both to the full release SHA; stage must not replace the production tag.
ASTERA_GIT_COMMIT=
ASTERA_STAGE_IMAGE=

# Match the recorded production gameplay flags when rehearsing the release.
PIRATE_BALANCE_V2_ENABLED=true
ADMIN_USERNAMES=
BOTS_ENABLED=true
BOTS_PER_GALAXY=100
SILENT_SPACE_ENABLED=true
SILENT_SPACE_BATCH=5
SILENT_SPACE_MAX_SHARDS=16

# Live checkout secrets are cleared by the stage Compose override.
VITE_GA_ID=

# Optional verified recovery email. Enable after DNS, secrets and all replicas are ready.
ACCOUNT_EMAIL_ENABLED=false
PASSWORD_RECOVERY_ENABLED=false
MAIL_DELIVERY_ENABLED=false
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
MAIL_FROM=Astera Online <security@account.asteraonline.space>
MAIL_REPLY_TO=support@asteraonline.space
AUTH_CODE_HMAC_SECRET=
MAIL_OUTBOX_ENCRYPTION_KEY=
# AUTH_CODE_HMAC_SECRET: at least 32 random characters.
# MAIL_OUTBOX_ENCRYPTION_KEY: exactly 64 hex characters (32 random bytes).
# Never prefix mail secrets with VITE_. Support inbox stays with Hostinger.
