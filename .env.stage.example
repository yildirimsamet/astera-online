# Copy to .env in ~/astera-stage; chmod 600. Generate fresh stage-only secrets.
POSTGRES_USER=astera
POSTGRES_DB=astera
POSTGRES_PASSWORD=
JWT_SECRET=

POSTGRES_PORT=5546
API_PORT_1=3300
API_PORT_2=3301
API_PORT_3=3302
WORKER_PORT=3310

# Pin both to the full release SHA; stage must not replace the production tag.
ASTERA_GIT_COMMIT=
ASTERA_STAGE_IMAGE=

# Match the recorded production gameplay flags when rehearsing the release.
ADMIN_USERNAMES=
BOTS_ENABLED=true
BOTS_PER_GALAXY=100
SILENT_SPACE_ENABLED=true
SILENT_SPACE_BATCH=5
SILENT_SPACE_MAX_SHARDS=16

# Live checkout secrets are cleared by the stage Compose override.
VITE_GA_ID=
