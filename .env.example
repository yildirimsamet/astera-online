# Copy to .env for local development. Never commit .env.

DATABASE_URL=postgres://astera:astera@localhost:5433/astera

# 3000 is a common default and is often already taken by another project on a
# dev machine; the web client's proxy expects 3100.
PORT=3100

# There is no SHARD_CODE any more (D21). One process serves all ten galaxies and
# works out which one a caller is in from their own player row. Open the world with:
#   pnpm --filter @astera/server season bootstrap

# 'api' serves HTTP, 'worker' drains scheduled events, 'both' does both.
ROLE=both

# How late a scheduled moment may be — a raid settling, a fleet landing, a radar
# warning firing. One second, because the lag is directly visible as a squadron
# holding over a world it has finished bombarding. See D52.
WORKER_POLL_MS=1000

LOG_LEVEL=info

# Must be set to something private in production. Rotating it ends every session.
JWT_SECRET=dev-only-secret-do-not-ship-me

# Comma-separated canonical usernames allowed to publish announcements and read feedback.
# Empty means the admin panel is disabled for every account.
ADMIN_USERNAMES=
