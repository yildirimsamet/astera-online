# Rendered on the VPS into $MONITORING_DIR/alertmanager.yml (docs/deployment.md,
# "Monitoring"): __ALERT_EMAIL__ comes from ALERT_EMAIL in ~/astera/.env, and the relay
# password file holds the Resend API key the game already sends mail with.
global:
  smtp_smarthost: smtp.resend.com:587
  smtp_from: 'Astera Alarm <alerts@account.asteraonline.space>'
  smtp_auth_username: resend
  smtp_auth_password_file: /etc/alertmanager/smtp_password
  smtp_require_tls: true

route:
  receiver: owner
  group_by: [alertname, service]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h

receivers:
  - name: owner
    email_configs:
      - to: '__ALERT_EMAIL__'
        send_resolved: true
