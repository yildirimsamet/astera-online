{
  "name": "blindspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "sim": "pnpm --filter @blindspace/sim start",
    "dev": "pnpm --parallel --filter @blindspace/server --filter @blindspace/web dev",
    "dev:server": "pnpm --filter @blindspace/server dev",
    "dev:web": "pnpm --filter @blindspace/web dev",
    "season": "pnpm --filter @blindspace/server season",
    "shots": "node tools/screenshots.mjs",
    "phone": "node tools/phone.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "verify": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.2",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "playwright": "^1.62.1",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^2.1.8"
  }
}
