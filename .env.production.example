# Astera Online — production environment.
#
# Copy to `.env` ON THE SERVER, beside docker-compose.prod.yml, and chmod 600.
# Never commit the filled-in copy.
#
#   cp .env.production.example .env && chmod 600 .env
#
# The two secrets below have no defaults on purpose: compose refuses to start
# without them rather than falling back to something guessable.

# ── secrets ──────────────────────────────────────────────────────────────────

# openssl rand -base64 32
POSTGRES_PASSWORD=

# openssl rand -base64 48
#
# ROTATING THIS ENDS EVERY SESSION IN THE GALAXY. Access and refresh tokens are
# stateless JWTs signed with it, so a new value does not invalidate a stolen
# token in isolation — it invalidates all of them, and every player is signed out
# on their next request. That is the intended emergency lever and a bad accident.
JWT_SECRET=
# Roll all replicas with false first, then enable and roll again (docs/deployment.md).
FIRST_GAME_SHIELD_ENABLED=true

# ── where things listen ──────────────────────────────────────────────────────
# Every port is published on 127.0.0.1 only. Chosen to sit clear of the other
# projects on this box; check with `ss -tlnp` before changing any of them.

API_PORT_1=3200
API_PORT_2=3201
API_PORT_3=3202
WORKER_PORT=3210
POSTGRES_PORT=5545

POSTGRES_USER=astera
POSTGRES_DB=astera

# ── tuning ───────────────────────────────────────────────────────────────────

# How late a scheduled moment may be — a raid settling, a fleet landing, a radar
# warning firing. One second, because the lag is directly visible as a squadron
# holding over a world it has finished bombarding (D52).
WORKER_POLL_MS=1000
WORKER_BATCH=100

# THE COMMANDERS THE SERVER PLAYS. D159.
#
# Off until the roster has names in it. `pnpm bots add "Kara Şahin" "Yıldız" …`
# fills the pool; the worker seats them gradually from real-player demand (up to
# BOTS_PER_GALAXY) and rotates activity from real-player presence. Nothing works
# between 01:00 and 08:00 Türkiye time. Awake bots count in the population
# figures like any other commander. Nothing here generates a
# name, and a short roster is a warning in the log rather than an invented one.
BOTS_ENABLED=false
BOTS_PER_GALAXY=100

# Paddle live checkout. Keep these only in the deployment secret store or local .env.
# Reuse the existing live webhook destination. Put its saved one-time signing
# secret in PADDLE_WEBHOOK_SECRET; never recreate the destination to retrieve it.
PADDLE_CHECKOUT_ENABLED=false
PADDLE_ENV=production
PADDLE_LIVE_API_KEY=
PADDLE_CLIENT_SIDE_TOKEN=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_LAVA=pri_01m3fwr44wjzkbenrjctb9k6dd
PADDLE_PRICE_ICE=pri_01m3fws4ewv6kp2yr4tztk8427
PADDLE_PRICE_TOXIC=pri_01m3fwtx8bvz0dbqdv3p18379m
PADDLE_PRICE_DESERT=pri_01m3fwvmk6eysq56ed05z1828m
PADDLE_PRICE_TURKEY=pri_01m3fx4wqpeqpzav659tz16e7t
PADDLE_PRICE_GERMANY=pri_01m3fx5v21rxrjaddw764dexe4
PADDLE_PRICE_FRANCE=pri_01m3fx6rg3nsn9nd3j179287hg
PADDLE_PRICE_SPAIN=pri_01m3fx85a9gb6gpkbbrjjry73p
PADDLE_PRICE_BUNDLE=pri_01m3fx3943k024e12yb67a49r1

# Polar live catalog. Do not enable checkout until account review and sandbox tests pass.
POLAR_CHECKOUT_ENABLED=false
POLAR_ENV=production
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_RETURN_URL=https://asteraonline.space/
POLAR_PRODUCT_LAVA=66986348-3d99-491a-812a-c811859d1a70
POLAR_PRODUCT_ICE=9ff2c27e-e9e1-4e7c-8382-7950c9ba834c
POLAR_PRODUCT_TOXIC=45eb7762-3d38-468f-9a8d-7364ac549ce5
POLAR_PRODUCT_DESERT=e4dcc308-8977-4e3a-a5b8-11219448321c
POLAR_PRODUCT_TURKEY=fdce9f79-5287-4a6a-936a-10a21ff72569
POLAR_PRODUCT_GERMANY=648b85c1-b04b-47bc-b742-b2ef73b91458
POLAR_PRODUCT_FRANCE=63bcf9e6-d0fc-4cc2-aaa6-533ca6b51f48
POLAR_PRODUCT_SPAIN=ab2d4302-5d25-4cb2-9007-c41ee5bdb0d9
POLAR_PRODUCT_JAPAN=82b25098-29bb-4b98-a8f4-11cb78ee2e7b
POLAR_PRODUCT_BUNDLE=34dcfb16-e875-43da-9a9d-e12ee4b5f335

# PostgreSQL's max_connections remains 100. Three API pools (3×8), the worker
# pool (12), LISTEN sockets and operations stay comfortably below it.
API_DB_POOL_MAX=8
WORKER_DB_POOL_MAX=12

# Hard ceilings protect PostgreSQL from a runaway sibling; reservations document
# the intended steady budget. CPU is deliberately allowed to burst across the six
# dedicated cores and is governed by the measured 70% sustained acceptance gate.
API_MEMORY_LIMIT=1g
API_MEMORY_RESERVATION=256m
WORKER_MEMORY_LIMIT=768m
WORKER_MEMORY_RESERVATION=256m
POSTGRES_MEMORY_LIMIT=4g
POSTGRES_MEMORY_RESERVATION=1g
VALKEY_MEMORY_LIMIT=128m
VALKEY_MEMORY_RESERVATION=64m

# Replica-local, bounded shared projections. Setting enabled=false is the safe
# rollback: reads get slower but remain correct.
PROJECTION_CACHE_ENABLED=true
PROJECTION_CACHE_MAX_SEASONS=16
PROJECTION_CACHE_MAX_ACCOUNTS=1024
COMMANDER_CACHE_TTL_MS=30000
PUBLIC_CACHE_TTL_MS=30000
TRAFFIC_CACHE_TTL_MS=5000
MINING_CACHE_TTL_MS=5000

# A client that cannot drain this much pending SSE data is closed and reconnects
# with jitter/resync instead of consuming unbounded server memory.
SSE_MAX_BUFFER_BYTES=65536

LOG_LEVEL=info

# Requests per minute per address, across the whole API. A commander at rest
# costs four polls a minute; one playing hard costs perhaps forty.
RATE_LIMIT_MAX=300

# Sign-in attempts per address per TEN MINUTES. This is the only brute-force
# defence in the system — sessions are stateless and there is no lockout.
RATE_LIMIT_AUTH_MAX=40

# Accounts created per address per HOUR. `/api/onboarding/claim` is
# unauthenticated and takes a SEAT in the frontier galaxy; galaxies hold 300
# commanders and fill strictly in order, so this ceiling is what stops one script
# from spending the only mitigation the empty-shard risk has (D21/D56).
RATE_LIMIT_SIGNUP_MAX=18

# ── the client ───────────────────────────────────────────────────────────────

# Google Analytics 4 measurement id, `G-XXXXXXXXXX`. LEAVE IT EMPTY and the built
# client installs no tag, makes no third-party request and defines no globals —
# that is the whole opt-out, and it is the default.
#
# It is INLINED INTO THE BUNDLE at build time, so changing it needs a redeploy
# rather than a container restart. `deploy/deploy.sh` reads it from here and
# passes it to `docker build`.
VITE_GA_ID=

